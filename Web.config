<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="ShopDB" connectionString="Data Source=|DataDirectory|/ShopDB.sqlite;Version=3;foreign keys=True" providerName="Mono.Data.Sqlite" />
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="MailFrom" value="noreply@shopease.local" />
  </appSettings>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="SpecifiedPickupDirectory">
        <!-- Emails are saved as .eml files here (no SMTP server needed for testing) -->
        <specifiedPickupDirectory pickupDirectoryLocation="/tmp/GlowUpMail" />
      </smtp>
    </mailSettings>
  </system.net>
  <system.web>
    <compilation debug="true" targetFramework="4.5">
      <assemblies>
        <add assembly="Mono.Data.Sqlite, Version=4.0.0.0, Culture=neutral, PublicKeyToken=0738eb9f132ed756" />
        <add assembly="System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.5" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" timeout="30" name=".SHOPEASEAUTH" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
</configuration>
