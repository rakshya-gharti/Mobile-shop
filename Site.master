<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GlowUp – Beauty &amp; Skincare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link id="cssLink" runat="server" href="~/Content/site.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
<form id="form1" runat="server">
    <!-- Lucide icons (ISC license, lucide.dev) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="i-house" viewBox="0 0 24 24"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" /><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" /></symbol><symbol id="i-shopping-cart" viewBox="0 0 24 24"><path d="m2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18" /><path d="M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25" /><circle cx="18" cy="20" r="2" /><circle cx="8" cy="20" r="2" /></symbol><symbol id="i-package" viewBox="0 0 24 24"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" /><path d="M12 22V12" /><polyline points="3.29 7 12 12 20.71 7" /><path d="m7.5 4.27 9 5.15" /></symbol><symbol id="i-user" viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></symbol><symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 5h16" /><path d="M4 12h16" /><path d="M4 19h16" /></symbol><symbol id="i-trophy" viewBox="0 0 24 24"><path d="M10 14.66V17a1 1 0 0 1-1 1 2 2 0 0 0-2 2v2" /><path d="M14 14.66V17a1 1 0 0 0 1 1 2 2 0 0 1 2 2v2" /><path d="M17.916 10H19.5A2.5 2.5 0 0 0 22 7.5V5a1 1 0 0 0-1-1h-3" /><path d="M4 22h16" /><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z" /><path d="M6.084 10H4.5A2.5 2.5 0 0 1 2 7.5V5a1 1 0 0 1 1-1h3" /></symbol><symbol id="i-triangle-alert" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" /><path d="M12 9v4" /><path d="M12 17h.01" /></symbol><symbol id="i-circle-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="m16 9-5.5 5.5L8 12" /></symbol><symbol id="i-star" viewBox="0 0 24 24"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></symbol><symbol id="i-chevron-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></symbol><symbol id="i-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></symbol></svg>
    <header class="topbar">
        <a href="<%= ResolveUrl("~/Default.aspx") %>" class="brand"><img src="<%= ResolveUrl("~/Images/logo.svg") %>" alt="GlowUp logo" /> GlowUp</a>
        <button type="button" id="menuBtn" class="menu-btn" aria-label="Menu"><svg class="ic" aria-hidden="true"><use href="#i-menu"/></svg></button>
    </header>
    <nav id="sideMenu" class="side-menu">
        <a href="<%= ResolveUrl("~/Default.aspx") %>">Home / Catalog</a>
        <a href="<%= ResolveUrl("~/Feedback.aspx") %>">Send Feedback</a>
        <asp:PlaceHolder ID="phGuest" runat="server">
            <a href="<%= ResolveUrl("~/Login.aspx") %>">Login</a>
            <a href="<%= ResolveUrl("~/Register.aspx") %>">Register</a>
        </asp:PlaceHolder>
        <asp:PlaceHolder ID="phMember" runat="server" Visible="false">
            <a href="<%= ResolveUrl("~/Member/Profile.aspx") %>">My Profile</a>
            <a href="<%= ResolveUrl("~/Member/Wishlist.aspx") %>">Wishlist</a>
            <a href="<%= ResolveUrl("~/Member/Orders.aspx") %>">Order History</a>
        </asp:PlaceHolder>
        <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
            <a href="<%= ResolveUrl("~/Admin/Default.aspx") %>">Admin Dashboard</a>
            <a href="<%= ResolveUrl("~/Admin/Products.aspx") %>">Manage Products</a>
            <a href="<%= ResolveUrl("~/Admin/Categories.aspx") %>">Manage Categories</a>
            <a href="<%= ResolveUrl("~/Admin/Orders.aspx") %>">Manage Orders</a>
            <a href="<%= ResolveUrl("~/Admin/Users.aspx") %>">Manage Users</a>
        </asp:PlaceHolder>
        <asp:LinkButton ID="lnkLogout" runat="server" Visible="false" OnClick="lnkLogout_Click" CausesValidation="false">Logout</asp:LinkButton>
    </nav>

    <asp:Label ID="lblDbError" runat="server" CssClass="alert error" Visible="false" />

    <main class="container">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <nav class="bottom-nav">
        <a href="<%= ResolveUrl("~/Default.aspx") %>"><svg class="ic" aria-hidden="true"><use href="#i-house"/></svg><span>Home</span></a>
        <a href="<%= ResolveUrl("~/Member/Wishlist.aspx") %>"><svg class="ic" aria-hidden="true"><use href="#i-heart"/></svg><span>Wishlist</span></a>
        <a href="<%= ResolveUrl("~/Member/Cart.aspx") %>"><svg class="ic" aria-hidden="true"><use href="#i-shopping-cart"/></svg><span>Cart<asp:Label ID="lblCount" runat="server" CssClass="badge" Visible="false" /></span></a>
        <a href="<%= ResolveUrl("~/Member/Orders.aspx") %>"><svg class="ic" aria-hidden="true"><use href="#i-package"/></svg><span>Orders</span></a>
        <a href="<%= ResolveUrl("~/Member/Profile.aspx") %>"><svg class="ic" aria-hidden="true"><use href="#i-user"/></svg><span>Account</span></a>
    </nav>
    <script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script>
</form>
</body>
</html>
